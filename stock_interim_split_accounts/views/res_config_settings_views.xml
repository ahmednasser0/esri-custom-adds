<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_interim_accounts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock.interim.split</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock_account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='valuation_setting_container']" position="after">
                <block title="Interim Accounts" name="interim_accounts_setting_container">
                    <setting string="Purchase Interim Account"
                             help="Receipt: Dr. Stock Valuation / Cr. this account. Vendor bill: Dr. this account / Cr. Payables.">
                        <field name="purchase_interim_account_id"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Sales Interim Account"
                             help="Delivery: Dr. this account / Cr. Stock Valuation. Customer invoice: Dr. COGS / Cr. this account.">
                        <field name="sale_interim_account_id"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
