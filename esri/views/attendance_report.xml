<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_attendance_report_list" model="ir.ui.view">
        <field name="name">attendance.report.list</field>
        <field name="model">attendance.report</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" edit="false">
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="date"/>
                <field name="department_id"/>
                <field name="check_in" widget="float_time" optional="hide"/>
                <field name="check_out" widget="float_time" optional="hide"/>
                <field name="first_check_in" widget="float_time"/>
                <field name="last_check_out" widget="float_time"/>
                <field name="late_minutes" widget="float_time" optional="show"/>
                <field name="early_leave_minutes" widget="float_time" optional="show"/>
                <field name="attendance_hours" widget="float_time" optional="show" sum="Total Attendance"/>
                <field name="activities_hours" widget="float_time" optional="show" sum="Total Activities"/>
                <field name="total_recorded_hours" widget="float_time" optional="show" sum="Total Recorded"/>
                <field name="difference" widget="float_time" optional="show"/>
                <field name="daily_check" widget="float_time" optional="hide"/>
                <field name="deduction" widget="float_time" sum="Total Deduction"/>
                <field name="deduction_state" widget="badge" optional="hide"
                       decoration-muted="deduction_state == 'archived'"/>
                <field name="monthly_permission" widget="float_time"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_report_form" model="ir.ui.view">
        <field name="name">attendance.report.form</field>
        <field name="model">attendance.report</field>
        <field name="arch" type="xml">
            <form string="Attendance" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="employee_code"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Attendance">
                            <field name="first_check_in" widget="float_time"/>
                            <field name="last_check_out" widget="float_time"/>
                            <field name="late_minutes" widget="float_time"/>
                            <field name="early_leave_minutes" widget="float_time"/>
                        </group>
                        <group string="Daily Activities">
                            <field name="date"/>
                            <field name="check_in" widget="float_time"/>
                            <field name="check_out" widget="float_time"/>
                            <field name="monthly_permission" widget="float_time"/>
                            <field name="comment"/>
                        </group>
                        <group string="Deduction">
                            <field name="attendance_hours" widget="float_time"/>
                            <field name="activities_hours" widget="float_time"/>
                            <field name="total_recorded_hours" widget="float_time"/>
                            <field name="difference" widget="float_time"/>
                            <field name="deduction" widget="float_time"/>
                            <field name="deduction_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Daily Activities" name="daily_activities">
                            <!-- Laid out like the Time Off list rather than
                                 pointed at it by xml id: Odoo moves those
                                 between versions and a missing one stops the
                                 module loading. -->
                            <field name="leave_ids" nolabel="1" readonly="1">
                                <list string="Time Off" create="false" edit="false" delete="false">
                                    <field name="holiday_status_id"/>
                                    <field name="request_date_from" string="Start Date"/>
                                    <field name="request_date_to" string="End Date"/>
                                    <field name="number_of_hours" widget="float_time" optional="show"/>
                                    <field name="state"
                                           decoration-success="state == 'validate'"
                                           decoration-info="state in ('confirm', 'validate1')"
                                           decoration-danger="state == 'refuse'"
                                           widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_attendance_report_search" model="ir.ui.view">
        <field name="name">attendance.report.search</field>
        <field name="model">attendance.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="date"/>
                <field name="department_id"/>
                <filter name="filter_working_day" string="Working Day" domain="[('comment', '=', 'working_day')]"/>
                <filter name="filter_weekend" string="Weekend" domain="[('comment', '=', 'weekend')]"/>
                <filter name="filter_public_holiday" string="Public Holiday" domain="[('comment', '=', 'public_holiday')]"/>
                <separator/>
                <filter name="filter_has_deduction" string="Has Deduction" domain="[('deduction', '>', 0)]"/>
                <filter name="filter_late" string="Late" domain="[('late_minutes', '>', 0)]"/>
                <filter name="filter_early_leave" string="Left Early" domain="[('early_leave_minutes', '>', 0)]"/>
                <filter name="filter_short_day" string="Short Day" domain="[('difference', '>', 0)]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_comment" string="Day Type" context="{'group_by': 'comment'}"/>
                    <filter name="group_by_deduction_state" string="Deduction Status" context="{'group_by': 'deduction_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_attendance_report_pivot" model="ir.ui.view">
        <field name="name">attendance.report.pivot</field>
        <field name="model">attendance.report</field>
        <field name="arch" type="xml">
            <pivot string="Attendance">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="total_recorded_hours" type="measure"/>
                <field name="deduction" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_attendance_report" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">attendance.report</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_attendance_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No attendance rows yet</p>
            <p>
                A row is written for every employee each day, and worked out
                again whenever that day's attendance, time off or deduction
                changes.
            </p>
        </field>
    </record>

    <!-- The report's parent menu. Declared without a parent of its own, which
         always loads, then moved into the Employees app by the call below:
         naming an hr menu in the xml broke the load twice, because Odoo moves
         those ids between versions. -->
    <menuitem id="menu_esri_attendance_reports"
              name="Attendance Report"
              sequence="90"/>

    <menuitem id="menu_attendance_report"
              name="Attendance"
              parent="menu_esri_attendance_reports"
              action="action_attendance_report"
              sequence="10"/>

    <function model="attendance.report" name="_attach_to_employees_app"/>
    <function model="attendance.report" name="_refresh_employee_codes"/>
    <function model="attendance.report" name="_recompute_day_figures"/>

    <!-- ─── Cron: create the attendance report rows ────────────────────── -->
    <record id="ir_cron_attendance_report" model="ir.cron">
        <field name="name">Attendance Report Records</field>
        <field name="model_id" ref="model_attendance_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_reports()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    </data>
</odoo>
