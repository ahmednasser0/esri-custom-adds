<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="view_time_off_balance_list" model="ir.ui.view">
        <field name="name">time.off.balance.list</field>
        <field name="model">time.off.balance</field>
        <field name="arch" type="xml">
            <list string="Time Off Balance" create="false" edit="false">
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="date"/>
                <field name="current_balance" widget="float_time"/>
                <field name="deduction" widget="float_time" sum="Total Deduction"/>
                <field name="actual_balance" widget="float_time"/>
            </list>
        </field>
    </record>

    <record id="view_time_off_balance_form" model="ir.ui.view">
        <field name="name">time.off.balance.form</field>
        <field name="model">time.off.balance</field>
        <field name="arch" type="xml">
            <form string="Time Off Balance" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="employee_code"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="current_balance" widget="float_time"/>
                            <field name="deduction" widget="float_time"/>
                            <field name="actual_balance" widget="float_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_time_off_balance_pivot" model="ir.ui.view">
        <field name="name">time.off.balance.pivot</field>
        <field name="model">time.off.balance</field>
        <field name="arch" type="xml">
            <pivot string="Time Off Balance">
                <field name="employee_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="deduction" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_time_off_balance_search" model="ir.ui.view">
        <field name="name">time.off.balance.search</field>
        <field name="model">time.off.balance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="employee_code"/>
                <field name="date"/>
                <filter name="filter_has_deduction" string="Has Deduction" domain="[('deduction', '>', 0)]"/>
                <filter name="filter_no_deduction" string="No Deduction" domain="[('deduction', '=', 0)]"/>
                <separator/>
                <filter name="filter_exhausted" string="Balance Exhausted" domain="[('actual_balance', '&lt;', 0)]"/>
                <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_time_off_balance" model="ir.actions.act_window">
        <field name="name">Time Off Balance</field>
        <field name="res_model">time.off.balance</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="view_time_off_balance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No balance rows yet</p>
            <p>
                A row is written for every employee each day, and worked out
                again whenever that day's attendance or deduction changes.
            </p>
        </field>
    </record>

    <!-- The parent both reports hang off. Declared without a parent of its
         own, which always loads, then moved into the Employees app by the call
         below: naming an hr menu in the xml broke the load twice, because Odoo
         moves those ids between versions. -->
    <menuitem id="menu_esri_attendance_reports"
              name="Attendance Report"
              sequence="90"/>

    <menuitem id="menu_time_off_balance"
              name="Time Off Balance"
              parent="menu_esri_attendance_reports"
              action="action_time_off_balance"
              sequence="20"/>

    <function model="time.off.balance" name="_attach_to_employees_app"/>

    <!-- ─── Cron: create the balance rows ──────────────────────────────── -->
    <record id="ir_cron_time_off_balance" model="ir.cron">
        <field name="name">Time Off Balance Records</field>
        <field name="model_id" ref="model_time_off_balance"/>
        <field name="state">code</field>
        <field name="code">model._cron_create_balances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    </data>
</odoo>
