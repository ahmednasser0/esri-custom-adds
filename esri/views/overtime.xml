<odoo>
    <data>

        <!-- ─── Form View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="overtime_form_view">
            <field name="name">hr.overtime.form</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <form string="Overtime" edit="false" create="false" delete="false">
                    <header>
                        <button name="action_post" string="Post" type="object"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_set_to_draft" string="Reset to Draft" type="object"
                                invisible="state != 'archived'"/>
                        <button name="action_archive_record" string="Archive" type="object"
                                invisible="state == 'archived'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,posted,archived"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="employee_id"    readonly="1"/>
                            <field name="date"           readonly="1"/>
                            <field name="employee_rule"  readonly="1"/>
                            <field name="overtime_start_time" widget="float_time" readonly="1"/>
                            <field name="worked_overtime" widget="float_time" readonly="1"/>
                        </group>
                        <group string="Overtime Breakdown">
                            <field name="overtime_hours_before_sunset"   widget="float_time" readonly="1"/>
                            <field name="overtime_hours_after_sunset"    widget="float_time" readonly="1"/>
                            <field name="total_overtime_hours"           widget="float_time" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ─── List View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="overtime_list_view">
            <field name="name">hr.overtime.list</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <list string="Overtime" create="false" edit="false">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="overtime_start_time" widget="float_time" optional="show"/>
                    <field name="worked_overtime" widget="float_time" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'posted'"
                           decoration-muted="state == 'archived'"/>
                </list>
            </field>
        </record>

        <!-- ─── Search View ───────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="overtime_search_view">
            <field name="name">hr.overtime.search</field>
            <field name="model">hr.overtime</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <filter name="filter_has_overtime" string="Has Overtime" domain="[('overtime_hours', '>', 0)]"/>
                    <filter name="filter_no_overtime" string="No Overtime" domain="[('overtime_hours', '=', 0)]"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                    <filter name="filter_archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <!-- ─── Action ────────────────────────────────────────────────────── -->
        <record id="overtime_action" model="ir.actions.act_window">
            <field name="name">Overtime</field>
            <field name="res_model">hr.overtime</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="overtime_search_view"/>
        </record>

        <!-- ─── Menu: child of Advanced Allocation ────────────────────────── -->
        <menuitem
            name="Overtime"
            id="overtime_menu"
            parent="attendance_deduction"
            action="overtime_action"
            sequence="20"/>

        <!-- ─── Cron: create daily overtime records ───────────────────────── -->
        <record id="ir_cron_daily_overtime" model="ir.cron">
            <field name="name">Daily Overtime Records</field>
            <field name="model_id" ref="model_hr_overtime"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_daily_overtime()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
