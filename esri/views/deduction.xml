<odoo>
    <data>

        <!-- ─── Form View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="deduction_form_view">
            <field name="name">deduction.form</field>
            <field name="model">deduction</field>
            <field name="arch" type="xml">
                <form string="Deduction" create="false">
                    <header>
                        <button name="action_set_to_draft" string="Reset to Draft" type="object"
                                invisible="state != 'archived'"/>
                        <button name="action_archive_record" string="Archive" type="object"
                                invisible="state == 'archived'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,archived"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Employee">
                                <field name="employee_id"   readonly="1"/>
                                <field name="date"          readonly="1"/>
                                <field name="employee_rule" readonly="1"/>
                            </group>
                            <group string="The Day">
                                <field name="core_check"  widget="float_time" readonly="1"/>
                                <field name="daily_check" widget="float_time" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Deduction">
                                <field name="deduction"     widget="float_time" readonly="1"/>
                                <field name="deducted_days"/>
                            </group>
                            <group string="Payroll">
                                <field name="work_entry"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"
                                   placeholder="Why the deduction was made"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ─── List View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="deduction_list_view">
            <field name="name">deduction.list</field>
            <field name="model">deduction</field>
            <field name="arch" type="xml">
                <list string="Deductions" create="false" edit="false"
                      decoration-muted="state == 'archived'">
                    <header>
                        <button name="action_run_post_deduction" string="Run Post Deduction" type="object"/>
                        <button name="action_run_work_entry" string="Run Work Entry" type="object"/>
                    </header>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="employee_rule" optional="hide"/>
                    <field name="core_check"    widget="float_time" optional="show"/>
                    <field name="daily_check"   widget="float_time" optional="show"/>
                    <field name="deduction"     widget="float_time" sum="Total Deduction"/>
                    <field name="deducted_days" optional="show" sum="Total Days"/>
                    <field name="description"   optional="show"/>
                    <field name="state" widget="badge"
                           decoration-muted="state == 'archived'"/>
                </list>
            </field>
        </record>

        <!-- ─── Search View ───────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="deduction_search_view">
            <field name="name">deduction.search</field>
            <field name="model">deduction</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="description"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                    <separator/>
                    <filter name="filter_has_deduction" string="Has Deduction" domain="[('deduction', '&gt;', 0)]"/>
                    <filter name="filter_no_deduction" string="No Deduction" domain="[('deduction', '=', 0)]"/>
                    <separator/>
                    <filter name="filter_date" string="Date" date="date"/>
                    <group>
                        <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_by_rule" string="Employee Rule" context="{'group_by': 'employee_rule'}"/>
                        <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ─── Action ────────────────────────────────────────────────────── -->
        <record id="deduction_action" model="ir.actions.act_window">
            <field name="name">Deduction</field>
            <field name="res_model">deduction</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="deduction_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No deduction rows yet</p>
                <p>
                    A row is written for every employee each day, and worked out
                    again whenever that day's attendance or time off changes.
                </p>
            </field>
        </record>

        <!-- ─── Menus ─────────────────────────────────────────────────────── -->
        <menuitem
            name="Advanced Allocation"
            id="attendance_deduction"
            parent="hr_attendance.menu_hr_attendance_root"
            sequence="10"/>

        <menuitem
            name="Deduction"
            id="deduction_menu"
            parent="attendance_deduction"
            action="deduction_action"
            sequence="10"/>

        <!-- ─── Cron: create daily deduction records ──────────────────────── -->
        <record id="ir_cron_daily_deduction" model="ir.cron">
            <field name="name">Daily Deduction Records</field>
            <field name="model_id" ref="esri.model_deduction"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_daily_deductions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    <function model="deduction" name="_migrate_dropped_states"/>
    <function model="deduction" name="_recompute_deducted_days"/>

    </data>
</odoo>
