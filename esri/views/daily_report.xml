<odoo>
    <data>

        <!-- ─── Form View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="daily_report_form_view">
            <field name="name">daily.report.form</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <form string="Daily Report" edit="false" create="false" delete="false">
                    <sheet>
                        <group>
                            <group string="Employee">
                                <field name="employee_id" readonly="1"/>
                                <field name="date"        readonly="1"/>
                            </group>
                            <group string="Check-out">
                                <field name="last_check_out"      widget="float_time" readonly="1"/>
                                <field name="effective_check_out" widget="float_time" readonly="1"/>
                                <field name="minus_minutes"       widget="float_time" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Worked Hours">
                                <field name="total_worked_hours"  widget="float_time" readonly="1"/>
                                <field name="actual_worked_hours" widget="float_time" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ─── List View ─────────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="daily_report_list_view">
            <field name="name">daily.report.list</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <list string="Daily Report" create="false" edit="false">
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="last_check_out"      widget="float_time" optional="show"/>
                    <field name="effective_check_out" widget="float_time" optional="show"/>
                    <field name="minus_minutes"       widget="float_time" optional="show"/>
                    <field name="total_worked_hours"  widget="float_time" sum="Total Worked"/>
                    <field name="actual_worked_hours" widget="float_time" sum="Total Actual"/>
                </list>
            </field>
        </record>

        <!-- ─── Search View ───────────────────────────────────────────────── -->
        <record model="ir.ui.view" id="daily_report_search_view">
            <field name="name">daily.report.search</field>
            <field name="model">daily.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <filter name="filter_has_minus" string="Minus Minutes"
                            domain="[('minus_minutes', '&gt;', 0)]"/>
                    <separator/>
                    <filter name="filter_date" string="Date" date="date"/>
                    <group>
                        <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ─── Action ────────────────────────────────────────────────────── -->
        <record id="daily_report_action" model="ir.actions.act_window">
            <field name="name">Daily Report</field>
            <field name="res_model">daily.report</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="daily_report_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No daily report rows yet</p>
                <p>
                    A row is written for every employee each day, and worked out
                    again whenever that day's attendance or time off changes.
                </p>
            </field>
        </record>

        <!-- ─── Menu ──────────────────────────────────────────────────────── -->
        <menuitem
            name="Daily Report"
            id="daily_report_menu"
            parent="attendance_deduction"
            action="daily_report_action"
            sequence="30"/>

        <!-- ─── Cron: create daily report records ─────────────────────────── -->
        <record id="ir_cron_daily_report" model="ir.cron">
            <field name="name">Daily Report Records</field>
            <field name="model_id" ref="model_daily_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_daily_reports()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
